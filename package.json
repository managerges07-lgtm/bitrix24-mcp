{
  "name": "bitrix24-mcp",
  "version": "2.0.0",
  "private": true,
  "description": "MCP server for Bitrix24 — connect Claude to CRM, tasks, disk, calendar, and more via OAuth or an incoming webhook.",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "start": "node index.js",
    "test": "node --test tests/taskcreator.test.mjs tests/oauth-refresh.test.mjs tests/mail.test.mjs && node tests/run-tests.mjs",
    "test:live": "node tests/run-tests.mjs --live",
    "smoke:bitrix-oauth": "node scripts/oauth-smoke.mjs"
  },
  "keywords": [
    "mcp",
    "bitrix24",
    "claude",
    "crm",
    "model-context-protocol",
    "anthropic",
    "ai"
  ],
  "author": "Bit2Beat <info@bit2beat.com> (https://bit2beat.com)",
  "license": "MIT",
  "homepage": "https://github.com/managerges07-lgtm/bitrix24-mcp#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/managerges07-lgtm/bitrix24-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/managerges07-lgtm/bitrix24-mcp/issues"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.29.0",
    "axios": "1.20.0",
    "cors": "2.8.6",
    "express": "5.2.1",
    "jose": "6.2.3",
    "zod": "3.25.76"
  },
  "engines": {
    "node": "24.20.0",
    "npm": "11.19.0"
  },
  "packageManager": "npm@11.19.0"
}
